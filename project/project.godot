; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Drawing App"
run/main_scene="res://scene/root/draw_scene.tscn"
config/features=PackedStringArray("4.3", "C#", "Mobile")
config/icon="res://res/project/app_icon.png"

[autoload]

NodeManager="*res://src/Tetraizor/Autoloads/NodeManager.cs"
ApplicationManager="*res://src/Tetraizor/Autoloads/ApplicationManager.cs"
InputManager="*res://src/Tetraizor/Autoloads/InputManager.cs"
ToolManager="*res://src/Tetraizor/Autoloads/ToolManager.cs"
ModalManager="*res://src/Tetraizor/Autoloads/ModalManager.cs"

[display]

window/size/viewport_width=2048
window/size/viewport_height=2048
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Drawing App"

[file_customization]

folder_colors={
"res://config/": "gray",
"res://prefab/": "purple",
"res://res/": "teal",
"res://scene/": "blue",
"res://src/": "red",
"res://src/Tetraizor/Utils/": "yellow"
}

[gui]

theme/custom="res://res/ui/config/main_theme.tres"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.611765, 0.611765, 0.611765, 1)
